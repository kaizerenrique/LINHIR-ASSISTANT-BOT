# =============================================================================
#  LINHIR ASSISTANT BOT — Configuración de entorno
# =============================================================================

# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=
# Opcional: ID de servidor de pruebas para sync instantáneo de slash commands.
DEV_GUILD_ID=

# --- Web API de Linhir (Sanctum) ---------------------------------------------
API_BASE_URL=https://linhir.online
API_PREFIX=/api/bot
API_TIMEOUT=10

# Token de la cuenta bot generada desde el panel de administración de Linhir.
# Formato: "ID|hash"  (ej: 3|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
BOT_ACCESS_TOKEN=

# --- Personalización ---------------------------------------------------------
GUILD_NAME=Linhir
EMBED_COLOR=0xC54B47
EMBED_ACCENT=0xD4B44A