# =============================================================================
#  LINHIR ASSISTANT BOT — Configuración de entorno
# =============================================================================

# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=
# Opcional: ID de servidor de pruebas para sync instantáneo de slash commands.
DEV_GUILD_ID=

# --- Web API de Linhir (Sanctum) ---------------------------------------------
API_BASE_URL=https://linhir.online
API_PREFIX=/api/bot
API_TIMEOUT=10

# Token de la cuenta bot generada desde el panel de administración de Linhir.
# Formato: "ID|hash"  (ej: 3|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
BOT_ACCESS_TOKEN=

# --- Personalización ---------------------------------------------------------
GUILD_NAME=Linhir
EMBED_COLOR=0xC54B47
EMBED_ACCENT=0xD4B44A

# --- Roles de Discord (para /register) ---
LINHIR_ROLE_ID=
PUBLICO_ROLE_ID=
OFFICER_ROLE_IDS=
NICKNAME_PREFIX=[LH]

# --- Canal de reportes automáticos ---
REPORT_CHANNEL_ID=

# --- Hora del reporte diario (UTC, formato HH:MM) ---
REPORT_HOUR_UTC=18:00

# --- Recordatorios masivos ---
# Segundos entre cada DM para respetar rate limits de Discord.
# Discord permite ~5 DMs cada 5s. Con 1.2s estamos seguros.
REMINDER_DM_DELAY=1.2